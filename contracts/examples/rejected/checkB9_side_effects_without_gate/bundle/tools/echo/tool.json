{
  "artifact": "tool_contract",
  "schema_version": "0.1",
  "name": "echo",
  "description": "return the given text and its character count; the mock adapter in this bundle stands in for the command",
  "inputs": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "message"
    ]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string"
      },
      "length": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "message",
      "length"
    ]
  },
  "errors": [
    "invalid_input"
  ],
  "side_effects": "runs_process",
  "safety_gate": {
    "required": false,
    "place": "none"
  },
  "idempotent": true,
  "timeout_s": null
}
