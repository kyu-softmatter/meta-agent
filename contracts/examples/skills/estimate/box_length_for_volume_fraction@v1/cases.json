  {
    "name": "eight particles of volume 1 at 0.5",
    "inputs": {
      "particle_count": 8,
      "particle_volume": 1.0,
      "volume_fraction": 0.5
    },
    "expect": {
      "box_volume": 16.0,
      "box_length": 2.5198420997897464
    },
    "worked": "V = 8 * 1 / 0.5 = 16; L = 16^(1/3)"
  },
  {
    "name": "a thousand particles of volume 0.5 at 0.25",
    "inputs": {
      "particle_count": 1000,
      "particle_volume": 0.5,
      "volume_fraction": 0.25
    },
    "expect": {
      "box_volume": 2000.0,
      "box_length": 12.599210498948732
    },
    "worked": "V = 1000 * 0.5 / 0.25 = 2000; L = 2000^(1/3)"
  }
