{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/handover_receipt.schema.json",
  "title": "handover_receipt",
  "description": "What the receiving bundle did with one value of a hand-over it received, written in its own received/ (meta_agent/tasks/031). It is used only for a row its build declared as taking a hand-over, converted through contracts/units.json, and into an engine's own unit only through a scale the person confirmed; anything else is held (MP10; the person, 2026-11-20, 'Use if declared'). The converted value itself is a row of the bundle's parameters, computed by its library skill.",
  "type": "object",
  "properties": {
    "card": {
      "const": "handover_receipt"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "numbers": {
      "type": "array",
      "maxItems": 0
    },
    "assumptions": {
      "type": "array"
    },
    "kb_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "case_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "case_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "note": {
      "type": "string"
    },
    "envelope": {
      "type": "string",
      "pattern": "^inbox/[A-Za-z][A-Za-z0-9._-]{1,80}/r[0-9]+_envelope\\.json$",
      "description": "the envelope, relative to the receiving bundle"
    },
    "payload_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "handover": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "the number's name in the hand-over"
    },
    "row": {
      "type": "string",
      "minLength": 1,
      "description": "the receiving bundle's parameter row the value is for"
    },
    "declared_in": {
      "type": [
        "string",
        "null"
      ],
      "description": "the file of the receiving bundle that declares that the row takes a hand-over, relative to the bundle; null when nothing does"
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_unit",
        "to_unit",
        "factor",
        "by"
      ],
      "properties": {
        "from_unit": {
          "$ref": "common.schema.json#/$defs/unit"
        },
        "to_unit": {
          "$ref": "common.schema.json#/$defs/unit"
        },
        "factor": {
          "type": [
            "number",
            "null"
          ],
          "description": "si_factor(from) / si_factor(to or the unit its scale stands for); null when none exists"
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "the library skill that computed the factor, <id>@v<n>"
        },
        "engine_scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "stands_for",
            "state"
          ],
          "properties": {
            "unit": {
              "$ref": "common.schema.json#/$defs/unit"
            },
            "stands_for": {
              "$ref": "common.schema.json#/$defs/unit"
            },
            "state": {
              "$ref": "common.schema.json#/$defs/setting_state"
            },
            "confirmed_by": {
              "type": "string"
            },
            "evidence": {
              "type": "array"
            }
          }
        }
      }
    },
    "state": {
      "enum": [
        "used",
        "held"
      ]
    },
    "reason": {
      "enum": [
        "undeclared",
        "unit_not_convertible",
        "engine_scale_not_confirmed",
        "conditions_not_met",
        "awaiting_person"
      ],
      "description": "why a held value is held; a used value has none"
    }
  },
  "required": [
    "card",
    "schema_version",
    "id",
    "revision",
    "author",
    "created_at",
    "numbers",
    "degraded",
    "status",
    "envelope",
    "payload_sha256",
    "handover",
    "name",
    "row",
    "declared_in",
    "conversion",
    "state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "held"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    }
  ]
}
