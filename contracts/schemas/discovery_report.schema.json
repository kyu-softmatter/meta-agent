{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/discovery_report.schema.json",
  "title": "discovery_report",
  "description": "Step 0 of onboarding: what was read and what was found, every field inferred with evidence or unknown (plan.md 5.0). Read by check 16 to know a field's state at the time a question was asked.",
  "type": "object",
  "properties": {
    "card": {
      "const": "discovery_report"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "numbers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/number"
      }
    },
    "assumptions": {
      "type": "array"
    },
    "kb_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "case_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "case_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "note": {
      "type": "string"
    },
    "lab_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "repo",
              "document",
              "card",
              "folder",
              "material",
              "link"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ]
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/stated"
      },
      "description": "dotted field paths of the lab profile → stated value"
    },
    "materials_seen": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "enum": [
        "full",
        "item"
      ]
    },
    "item": {
      "type": "string",
      "description": "when scope is item: the material or tool this re-run covered"
    }
  },
  "required": [
    "card",
    "schema_version",
    "id",
    "revision",
    "author",
    "created_at",
    "numbers",
    "degraded",
    "status",
    "lab_id",
    "inputs",
    "fields",
    "scope"
  ],
  "additionalProperties": false
}
