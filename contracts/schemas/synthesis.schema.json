{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/synthesis.schema.json",
  "title": "synthesis",
  "description": "Conflicts between axes and how they were resolved (plan.md 5.1 S4).",
  "type": "object",
  "properties": {
    "card": {
      "const": "synthesis"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "numbers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/number"
      }
    },
    "assumptions": {
      "type": "array"
    },
    "kb_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "case_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "case_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "note": {
      "type": "string"
    },
    "rid": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "thread": {
      "type": "string"
    },
    "axis_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "between": {
            "type": "array",
            "items": {
              "enum": [
                "A1",
                "A2",
                "A3",
                "A4",
                "A5",
                "A6"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "decided_by": {
            "enum": [
              "priorities",
              "lab_profile",
              "human",
              "unresolved"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "between",
          "issue",
          "resolution",
          "decided_by"
        ]
      }
    },
    "held": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/held_item"
      }
    }
  },
  "required": [
    "card",
    "schema_version",
    "id",
    "revision",
    "author",
    "created_at",
    "numbers",
    "degraded",
    "status",
    "axis_refs",
    "conflicts",
    "held"
  ],
  "additionalProperties": false
}
