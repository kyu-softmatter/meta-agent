{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/harness_experience.schema.json",
  "title": "harness_experience",
  "description": "One lesson in harness/library/<domain>/<build_id>/ (plan.md 5.5). A lesson resting only on confounded verdicts is NO_ENTRY. Check 13.",
  "type": "object",
  "properties": {
    "card": {
      "const": "harness_experience"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "numbers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/number"
      }
    },
    "assumptions": {
      "type": "array"
    },
    "kb_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "case_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "case_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "note": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "build_ref": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "proposal_ref": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "cue": {
      "type": "string",
      "minLength": 1
    },
    "lesson": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "run",
              "commit",
              "card"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "contrast": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ]
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "why"
      ]
    },
    "rests_on_verdicts": {
      "type": "array",
      "items": {
        "enum": [
          "helped",
          "hurt",
          "no_observed_effect",
          "confounded"
        ]
      },
      "minItems": 1
    },
    "library_entry": {
      "enum": [
        "entered",
        "NO_ENTRY"
      ]
    },
    "diff_ref": {
      "type": "string"
    }
  },
  "required": [
    "card",
    "schema_version",
    "id",
    "revision",
    "author",
    "created_at",
    "numbers",
    "degraded",
    "status",
    "domain",
    "build_ref",
    "proposal_ref",
    "cue",
    "lesson",
    "evidence",
    "confidence",
    "rests_on_verdicts",
    "library_entry"
  ],
  "additionalProperties": false
}
