{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/assignment.schema.json",
  "title": "assignment",
  "description": "What a hub agent asks one member to do (meta_agent/tasks/033). Written by the hub in its assignments/ and carried by the bridge into the member's inbox/<thread>/ on the hub's trigger ('Assign freely, carry on my word (Recommended)'). It carries no number; a value the member needs reaches it as a card of its own.",
  "type": "object",
  "properties": {
    "card": {
      "const": "assignment"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "numbers": {
      "type": "array",
      "maxItems": 0,
      "description": "none: what is asked is in words, and every value stays in a card a member wrote"
    },
    "assumptions": {
      "type": "array"
    },
    "kb_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "case_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "case_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "note": {
      "type": "string"
    },
    "thread": {
      "$ref": "common.schema.json#/$defs/id",
      "description": "the thread between the hub and this member; the member's inbox/<thread>/ is named by it"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "question": {
      "$ref": "common.schema.json#/$defs/id",
      "description": "the hub_question this assignment belongs to"
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "build"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "the agent's name, as its bundle's CLAUDE.md names it"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "description": "the build that made the bundle, <name>/<NNNN> (its build card)"
        }
      },
      "description": "the hub"
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "build"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "the agent's name, as its bundle's CLAUDE.md names it"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "description": "the build that made the bundle, <name>/<NNNN> (its build card)"
        }
      },
      "description": "the member, as members.json names it"
    },
    "asks": {
      "type": "string",
      "minLength": 1,
      "description": "what the member is to find or do, in words; no number"
    },
    "answers_items": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "description": "the question's done_when items this assignment is to answer"
    },
    "returns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card",
          "to"
        ],
        "properties": {
          "card": {
            "enum": [
              "result",
              "handover"
            ]
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "build"
            ],
            "properties": {
              "agent": {
                "type": "string",
                "minLength": 1,
                "description": "the agent's name, as its bundle's CLAUDE.md names it"
              },
              "build": {
                "type": "string",
                "minLength": 1,
                "description": "the build that made the bundle, <name>/<NNNN> (its build card)"
              }
            },
            "description": "the hub for a result; another member for a hand-over, which crosses only on the person's word"
          }
        }
      },
      "description": "the cards the hub expects back"
    },
    "done_when": {
      "type": "string",
      "minLength": 1,
      "description": "what the member's result must hold, in words"
    }
  },
  "required": [
    "card",
    "schema_version",
    "id",
    "revision",
    "author",
    "created_at",
    "numbers",
    "degraded",
    "status",
    "thread",
    "round",
    "question",
    "from",
    "to",
    "asks",
    "returns",
    "done_when"
  ],
  "additionalProperties": false
}
