{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/result.schema.json",
  "title": "result",
  "description": "What a member agent returns to its hub for one assignment (meta_agent/tasks/033). Written by the member in its outbox/ and carried by the bridge into the hub's inbox/<thread>/ on the hub's trigger. The hub quotes it by path and computes, converts and judges nothing in it.",
  "type": "object",
  "properties": {
    "card": {
      "const": "result"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "numbers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/number"
      }
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/series"
      },
      "description": "series the result quotes, each as a tool output gave it, where the producing build declares it (tasks/034, rheo-4)"
    },
    "assumptions": {
      "type": "array"
    },
    "kb_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "case_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "case_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "note": {
      "type": "string"
    },
    "thread": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "build"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "the agent's name, as its bundle's CLAUDE.md names it"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "description": "the build that made the bundle, <name>/<NNNN> (its build card)"
        }
      },
      "description": "the member"
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "build"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "the agent's name, as its bundle's CLAUDE.md names it"
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "description": "the build that made the bundle, <name>/<NNNN> (its build card)"
        }
      },
      "description": "the hub"
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "envelope"
      ],
      "properties": {
        "assignment": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "envelope": {
          "type": "string",
          "minLength": 1,
          "description": "the envelope in the member's inbox/<thread>/ that carried the assignment"
        }
      }
    },
    "state": {
      "enum": [
        "answered",
        "held",
        "partly_held"
      ]
    },
    "produced_by": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "record"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": "string",
            "minLength": 1,
            "description": "the run record's path inside the member"
          }
        }
      },
      "description": "what the values were read off"
    },
    "held": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "reason",
          "needs"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "what was not answered, why, and what it needs"
    }
  },
  "required": [
    "card",
    "schema_version",
    "id",
    "revision",
    "author",
    "created_at",
    "numbers",
    "degraded",
    "status",
    "thread",
    "round",
    "from",
    "to",
    "answers",
    "state",
    "held"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "held",
              "partly_held"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "held": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "answered"
          }
        }
      },
      "then": {
        "properties": {
          "held": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
