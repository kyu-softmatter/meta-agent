{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/common.schema.json",
  "title": "common definitions",
  "description": "Shared definitions for every card (plan.md 6.2, 6.3). Compatible in shape with soft-matter-agents' common.schema.json: numbers are the 4-tuple plus value_kind, grades are derived (contracts/grades.json), E6 enters no card.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,80}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$"
    },
    "seat": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z]+-[0-9]{8}-[0-9]+$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "a seat name (<role>-<machine>-<YYYYMMDD>-<n>) or the literal 'human'"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "description": "a key of contracts/units.json"
    },
    "grade": {
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "E6"
      ]
    },
    "value_kind": {
      "enum": [
        "measured",
        "correlation",
        "computed",
        "predicted",
        "literature",
        "estimated",
        "model_generated"
      ]
    },
    "claim_kind": {
      "enum": [
        "observed",
        "derived",
        "inferred",
        "unknown"
      ]
    },
    "claim_basis": {
      "enum": [
        "documentation",
        "source",
        "binary",
        "runtime",
        "run_record"
      ]
    },
    "setting_state": {
      "enum": [
        "confirmed",
        "inferred",
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "approved",
        "done",
        "refused",
        "held",
        "superseded"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z_]+:.+$",
      "description": "<source_kind>:<locator>; the kind is a key of contracts/grades.json"
    },
    "number": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/unit"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        },
        "grade": {
          "$ref": "common.schema.json#/$defs/grade"
        },
        "value_kind": {
          "$ref": "common.schema.json#/$defs/value_kind"
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ]
        },
        "conditions": {
          "type": "object"
        },
        "expires": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "bench_confirmed": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "source",
        "grade",
        "value_kind"
      ]
    },
    "evidence_item": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "rea_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "locus": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "locus"
      ],
      "anyOf": [
        {
          "required": [
            "source_ref"
          ]
        },
        {
          "required": [
            "rea_evidence_id"
          ]
        }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence_item"
      }
    },
    "stated": {
      "type": "object",
      "properties": {
        "value": {},
        "state": {
          "$ref": "common.schema.json#/$defs/setting_state"
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidence"
        },
        "confirmed_by": {
          "type": "string"
        },
        "date": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "state"
      ],
      "description": "a setting with the three-state vocabulary; checks 15 and 17 enforce the state conditions"
    },
    "stated_group": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/stated"
      },
      "minProperties": 1
    },
    "ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "gap": {
      "type": "object",
      "properties": {
        "what": {
          "type": "string",
          "minLength": 1
        },
        "searched": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string"
        },
        "requires": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "what",
        "searched"
      ]
    },
    "held_item": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string"
            },
            "released_by": {
              "type": "string"
            },
            "released_at": {
              "$ref": "common.schema.json#/$defs/date"
            }
          },
          "additionalProperties": false,
          "required": [
            "item"
          ]
        }
      ]
    },
    "analysis_permission": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "granted_by": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "description": "a license clause or a docs/ideas commit"
            },
            "date": {
              "$ref": "common.schema.json#/$defs/date"
            }
          },
          "additionalProperties": false,
          "required": [
            "granted_by",
            "scope",
            "basis",
            "date"
          ]
        }
      ]
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/claim_kind"
        },
        "basis": {
          "$ref": "common.schema.json#/$defs/claim_basis"
        },
        "evidence": {
          "$ref": "common.schema.json#/$defs/evidence"
        },
        "limitations": {
          "type": "string"
        },
        "requires": {
          "type": "string"
        },
        "capability": {
          "type": "string",
          "description": "which capability item this claim speaks to (function, command, io_format, parameter, range, constraint, observable, gap)"
        }
      },
      "additionalProperties": false,
      "required": [
        "claim",
        "kind",
        "basis",
        "evidence"
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "invalid_input",
            "unsupported_target",
            "integrity_mismatch",
            "truncated",
            "cancelled",
            "timeout",
            "resource_constraint",
            "unavailable",
            "execution_failure",
            "refused_by_safety",
            "permission_required"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "remediation": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "action"
          ]
        },
        "evidence": {}
      },
      "additionalProperties": false,
      "required": [
        "code",
        "category",
        "message",
        "retryable",
        "remediation"
      ]
    },
    "edit_row": {
      "type": "object",
      "properties": {
        "component": {
          "enum": [
            "system_prompt",
            "guardrails",
            "memory",
            "tool_guidance",
            "skills",
            "subagents",
            "scripts",
            "hooks"
          ]
        },
        "change": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "helped",
            "hurt",
            "no_observed_effect",
            "confounded"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "component",
        "change",
        "observed",
        "verdict"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "rollouts": {
          "type": "integer",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_s": {
          "type": "number",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "usd_basis": {
          "enum": [
            "provider",
            "computed"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "rollouts",
        "sessions",
        "tokens_in",
        "tokens_out",
        "usd",
        "usd_basis"
      ]
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    }
  }
}
