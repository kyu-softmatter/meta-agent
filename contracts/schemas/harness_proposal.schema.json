{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-agent.invalid/schemas/harness_proposal.schema.json",
  "title": "harness_proposal",
  "description": "One structural change with its proof and edit rows (plan.md 5.5). A proposal lands nothing. Checks 9, 13.",
  "type": "object",
  "properties": {
    "card": {
      "const": "harness_proposal"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "superseded_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/author"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "numbers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/number"
      }
    },
    "assumptions": {
      "type": "array"
    },
    "kb_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "case_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ref"
      }
    },
    "case_gaps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/gap"
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "note": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "tighten",
        "loosen",
        "reshape",
        "retire"
      ]
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "path",
          "owner",
          "change"
        ]
      }
    },
    "edit_rows": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/edit_row"
      }
    },
    "proof": {
      "type": "object",
      "properties": {
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "watched_failing_before": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "watched_passing_after": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "path"
            ]
          }
        },
        "replay": {
          "type": "object",
          "properties": {
            "range": {
              "type": [
                "string",
                "null"
              ]
            },
            "new_fail": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "fixtures",
        "replay"
      ]
    },
    "persons_words": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "docs_ideas_commit": {
              "$ref": "common.schema.json#/$defs/commit"
            }
          },
          "additionalProperties": false,
          "required": [
            "quote",
            "docs_ideas_commit"
          ]
        }
      ]
    },
    "touches_core": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "needs_threshold": {
      "type": "boolean"
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    }
  },
  "required": [
    "card",
    "schema_version",
    "id",
    "revision",
    "author",
    "created_at",
    "numbers",
    "degraded",
    "status",
    "kind",
    "class",
    "answers",
    "changes",
    "edit_rows",
    "proof",
    "persons_words",
    "touches_core",
    "needs_threshold",
    "cost"
  ],
  "additionalProperties": false
}
