{
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "PowerShell(ssh *)",
      "Bash(scp *)",
      "PowerShell(scp *)",
      "Bash(curl *)",
      "PowerShell(curl *)",
      "Bash(wget *)",
      "PowerShell(wget *)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "PowerShell(git commit -n *)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(rm -rf *)",
      "PowerShell(rm -rf *)",
      "Edit(envelope/safety.json)",
      "Write(envelope/safety.json)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python src/gate.py --self-check || exit 2"
          }
        ]
      }
    ]
  }
}
