    "type": "object",
    "properties": {
      "session": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "session"
    ]
  },
  "outputs": {
    "type": "object",
    "properties": {
      "closed": {
        "type": "boolean"
      }
    },
    "required": [
      "closed"
    ]
  },
  "errors": [
    "invalid_input"
  ],
  "side_effects": "reads_instrument",
  "safety_gate": {
    "required": false,
    "place": "the tool reads the instrument and changes nothing; src/gate.py is consulted by the runner and finds no gate required"
  },
  "idempotent": true,
  "timeout_s": null
}
