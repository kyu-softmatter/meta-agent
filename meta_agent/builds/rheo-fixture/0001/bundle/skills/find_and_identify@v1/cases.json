[
  {
    "name": "one instrument answers: it is opened, identified and closed",
    "inputs": {
      "address": null
    },
    "transcript": [
      {
        "tool": "list_devices",
        "input": {},
        "output": {
          "devices": [
            {
              "address": "mock:rheo-1",
