            }
          ]
        }
      },
      {
        "tool": "open_session",
        "input": {
          "address": "mock:rheo-1"
        },
        "output": {
          "session": "s-1"
        }
      },
      {
        "tool": "identify",
        "input": {
          "session": "s-1"
        },
        "output": {
          "manufacturer": "Fixture Instruments",
          "model": "FR-1",
          "serial": "FX-0001",
          "firmware": "1.0.0"
        }
      },
      {
        "tool": "close_session",
        "input": {
          "session": "s-1"
        },
        "output": {
          "closed": true
        }
      }
    ],
    "expect": {
      "identified": true,
      "found": [
        "mock:rheo-1"
      ],
      "address": "mock:rheo-1",
      "session_closed": true,
      "identity": [
        {
          "field": "manufacturer",
          "value": "Fixture Instruments",
          "kind": "observed",
          "tool": "identify"
        },
        {
          "field": "model",
          "value": "FR-1",
          "kind": "observed",
          "tool": "identify"
        },
        {
          "field": "serial",
          "value": "FX-0001",
          "kind": "observed",
          "tool": "identify"
        },
        {
          "field": "firmware",
          "value": "1.0.0",
          "kind": "observed",
          "tool": "identify"
        }
      ]
    },
    "expect_calls": [
      "list_devices",
      "open_session",
      "identify",
      "close_session"
    ]
  },
