{
  "permissions": {
    "deny": [
      "Bash(ssh *)",
      "PowerShell(ssh *)",
      "Bash(scp *)",
      "PowerShell(scp *)",
      "Bash(curl *)",
      "PowerShell(curl *)",
      "Bash(wget *)",
      "PowerShell(wget *)",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git commit --no-verify*)",
      "PowerShell(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "PowerShell(git commit -n *)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(rm -rf *)",
      "PowerShell(rm -rf *)",
      "Edit(envelope/safety.json)",
      "Write(envelope/safety.json)",
      "Edit(envelope/execution_permission.json)",
      "Write(envelope/execution_permission.json)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(inbox/**)",
      "Write(inbox/**)",
      "Edit(outbox/**)",
      "Write(outbox/**)",
      "Edit(received/**)",
      "Write(received/**)",
      "Edit(envelope/handovers.json)",
      "Write(envelope/handovers.json)",
      "Edit(envelope/units.json)",
      "Write(envelope/units.json)",
      "Edit(envelope/results.json)",
      "Write(envelope/results.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/src/gate.py\" --self-check || exit 2"
          }
        ]
      }
    ]
  }
}
